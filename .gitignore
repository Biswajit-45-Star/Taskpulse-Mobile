# Root gitignore for React Native / Expo project

# Node dependencies
node_modules/

# Environment files
.env
.env.*
.env*.local

# Expo
.expo/
.expo-shared/
app.json
web-build/
dist/
expo-env.d.ts

# Build outputs
build/
**/build/
**/dist/
**/out/

# TypeScript
*.tsbuildinfo

# Metro
.metro-health-check*

# Android
android/.gradle/
android/app/build/
**/android/**/build/
*.keystore
*.jks
*.p12
*.key
*.pem
*.mobileprovision

# iOS
ios/Pods/
ios/build/
**/ios/**/build/
*.xcworkspace
*.xcuserdata
*.xcodeproj/project.xcworkspace/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# macOS
.DS_Store

# Windows
Thumbs.db

# IDEs and editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Generated files
**/src/generated/
**/prisma/

# Misc
*.orig
